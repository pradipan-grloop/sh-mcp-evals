# Copy this file to .env and fill it in. .env is ignored by git: never commit it.

# Claude, for the runs and the judge. Leave it empty if you signed in with `ant auth login`.
ANTHROPIC_API_KEY=

# A READ_ONLY agent token (sh_agent_...) for each environment you run against.
# A super admin creates one per environment. Agent tokens last 90 days by default.
SH_EVAL_TOKEN_QA_READ=
SH_EVAL_TOKEN_STAGING_READ=
SH_EVAL_TOKEN_DEV_READ=
SH_EVAL_TOKEN_LOCAL_READ=
